{
  "name": "cenan-app",
  "productName": "Cenan AI",
  "private": true,
  "version": "0.0.0",
  "description": "Cenan AI Muhasebe ve İhracat Asistanı",
  "author": "Cenan",
  "license": "UNLICENSED",
  "type": "module",
  "main": "electron/main.js",
  "desktopName": "cenan-ai.desktop",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:dev": "node electron/dev.mjs",
    "electron:preview": "npm run build && electron .",
    "electron:build": "npm run build && electron-builder"
  },
  "build": {
    "appId": "ai.cenan.app",
    "productName": "Cenan AI",
    "copyright": "Copyright © Cenan",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "icon": "build/icon.png",
    "files": [
      "dist/**",
      "electron/main.js",
      "electron/preload.cjs",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.business"
    },
    "linux": {
      "target": "AppImage",
      "category": "Office",
      "syncDesktopName": true,
      "synopsis": "Cenan AI Muhasebe ve İhracat Asistanı"
    }
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
